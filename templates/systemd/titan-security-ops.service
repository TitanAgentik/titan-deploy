[Unit]
Description=TITAN Security Ops (four-pillar posture / lockdown)
After=network.target titan-risk-kernel.service titan-signing-node.service

[Service]
Type=simple
Environment=TITAN_POLICY_PATH=%h/.openclaw/risk_kernel/policy.yaml
Environment=TITAN_SAFETY_DIR=%h/.openclaw/safety
Environment=PYTHONPATH=%h/.openclaw/safety
ExecStart=/usr/bin/python3 -m titan_safety.security_service
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
