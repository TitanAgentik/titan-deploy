[Unit]
Description=Hermes Agent Gateway (TITAN)
After=network-online.target openclaw-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=%i
Environment=HOME=%h
Environment=HERMES_HOME=%h/.hermes
EnvironmentFile=-%h/.openclaw/.env
ExecStart=/usr/bin/hermes gateway start --config %h/.hermes/config.yaml
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
