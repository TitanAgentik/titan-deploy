# TITAN live capital — copy to ~/.openclaw/.env (never commit secrets)
# Operator fills values before first live trade. Missing vars → fail-closed DENY.
# Strict DEX-only (R02 / R46) — no CEX API keys.

# --- Control plane / comms ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Legacy alias: TELEGRAM_USER_ID=
NATS_URL=nats://127.0.0.1:4222

# --- Honcho dialectic user modeling (Hermes memory provider) ---
# Cloud: get key at https://honcho.dev — also copy to ~/.hermes/.env
# Self-hosted: set HONCHO_BASE_URL + JWT signed with server AUTH_JWT_SECRET
HONCHO_API_KEY=
HONCHO_BASE_URL=
# Optional: override default peer name (template default: hyperion)
HONCHO_PEER_NAME=hyperion

# --- Live profile arm switches (fail-closed until set) ---
TITAN_LIVE_SIGNING_READY=0
# Set to 1 only after Trezor bridge + signing_node health OK

# --- Reconciliation (positions vs on-chain / DEX — never CEX) ---
# Preferred: HTTP aggregator returning {"positions":[{venue,contract,notional_usd,side}]}
TITAN_RECON_FETCHER_URL=
# DEX / on-chain only:
HYPERLIQUID_PRIVATE_KEY=
HYPERLIQUID_WALLET_ADDRESS=

# --- EVM / Solana RPC (EDGE-FRA Erigon + local Solana) ---
ETH_RPC_URL=
ERIGON_HTTP_URL=http://127.0.0.1:8545
SOLANA_RPC_URL=
GEYSER_GRPC_URL=
JITO_BLOCK_ENGINE_URL=https://frankfurt.mainnet.block-engine.jito.wtf

# --- Signing (isolated signing_node :19010) ---
TREZOR_BRIDGE_SOCKET=/run/openclaw/trezor-bridge.sock
OPENCLAW_TREZOR_BRIDGE=
# Optional override: TITAN_SIGNER_MODULE=titan_safety.adapters.live_bundle:live_signer

# --- Edge mesh (full 5-PoP — bootstrap each PoP after WireGuard) ---
# POP=EDGE-TKY bash ~/.openclaw/infra/edge_pop_bootstrap.sh
# Route check: titan-safety edge route --venue jito --strategy P22
TITAN_EDGE_MESH=~/.openclaw/infra/edge_mesh.yaml
EDGE_FRA_RPC=

# --- Titan safety API health (CLI / curl — not a web cockpit) ---
VITE_TITAN_STATUS_URL=http://127.0.0.1:19003/health
VITE_TITAN_KERNEL_URL=http://127.0.0.1:19001/health
